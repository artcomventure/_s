{
  "name": "_s",
  "version": "2.1.1",
  "description": "I'm the next, most awesome, WordPress theme out there.",
  "author": "SMITH",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "WordPress",
    "Theme"
  ],
  "homepage": "https://github.com/artcomventure/_s",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artcomventure/_s.git"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@wordpress/icons": "^9.37.0",
    "@wordpress/scripts": "^26.17.0",
    "autoprefixer": "^10.6.1",
    "browser-sync": "^2.29.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fantasticon": "^2.0.0",
    "globals": "^17.13.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.31",
    "sass": "1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "scripts": {
    "browser-sync": "browser-sync http://localhost --port 3456 --ui-port 3457 --files **/*.css,**/*.min.js,**/*.php --no-open",

    "watch": "npm-run-all --parallel watch:* & npm run browser-sync",
    "watch:scss": "node utilities/bin/build-css.mjs css/style.scss . --watch",
    "watch:atf": "node utilities/bin/build-css.mjs css/above-the-fold.scss --watch",
    "watch:js": "node utilities/bin/build-js.mjs --watch --recursive js",

    "prebuild": "npm run lint",
    "build": "npm-run-all --parallel build:*",
    "build:scss": "node utilities/bin/build-css.mjs css/style.scss .",
    "build:atf": "node utilities/bin/build-css.mjs css/above-the-fold.scss",
    "build:js": "node utilities/bin/build-js.mjs --recursive js",

    "lint": "npm-run-all --parallel lint:*",
    "lint:js": "eslint js",
    "lint:ts": "tsc --noEmit",
    "lint:css": "stylelint \"css/**/*.scss\"",

    "test": "playwright test -c utilities/tests",
    "test:live": "TEST_ENV=live npm test",
    "test:stage": "TEST_ENV=stage npm test",
    "test:visual": "TEST_VISUAL=1 playwright test -c utilities/tests",
    "test:visual:reference": "TEST_ENV=live npm run test:visual -- --update-snapshots=all",
    "test:visual:reference:stage": "TEST_ENV=stage npm run test:visual -- --update-snapshots=all",
    "test:report": "playwright show-report utilities/tests/playwright-report",

    "i18n:scan": "npm run i18n:pot && npm run i18n:po",
    "i18n:pot": "wp i18n make-pot . languages/_s.pot --merge=languages/_s+.pot --exclude=src,node_modules,**/*.min.*,utilities",
    "i18n:po": "wp i18n update-po languages/_s.pot languages",
    "i18n:create": "npm run i18n:mo & npm run i18n:json",
    "i18n:mo": "wp i18n make-mo languages languages",
    "i18n:json": "wp i18n make-json languages --no-purge",

    "watch:editor": "node utilities/bin/build-css.mjs css/editor-style.scss --watch",
    "build:editor": "node utilities/bin/build-css.mjs css/editor-style.scss",

    "icont:generate": "cd media/fonts/Icont && npm run generate"
  },
  "dependencies": {
    "normalize.css": "^8.0.1"
  }
}
