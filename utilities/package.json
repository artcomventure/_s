{
  "scripts": {
    "watch": "npm run watch:scss & npm run watch:js",
    "watch:scss": "node bin/build-css.mjs css --watch",
    "watch:js": "node bin/build-js.mjs js --watch",

    "prebuild": "npm run lint",
    "build": "npm run build:scss & npm run build:js",
    "build:scss": "node bin/build-css.mjs css",
    "build:js": "node bin/build-js.mjs js",

    "lint": "npm-run-all --parallel lint:*",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.scss\"",

    "i18n:scan": "npm run i18n:pot && npm run i18n:po",
    "i18n:pot": "wp i18n make-pot . languages/utilities.pot --domain=utilities --exclude=src,dotlottie-wc,video.js,node_modules,**/*.min.* --subtract=../languages/_s.pot --package-name=Utilities",
    "i18n:po": "wp i18n update-po languages/utilities.pot languages",
    "i18n:create": "npm run i18n:mo & npm run i18n:json",
    "i18n:mo": "wp i18n make-mo languages languages",
    "i18n:json": "wp i18n make-json languages --no-purge"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-wc": "^0.6.4",
    "air-datepicker": "^3.5.0",
    "autosize": "^6.0.1",
    "custom-select": "^1.1.15",
    "formbouncerjs": "^1.4.6",
    "gsap": "^3.12.5",
    "lottie-web": "^5.12.2",
    "pjax": "^0.2.8",
    "tom-select": "^2.5.2",
    "video.js": "^8.23.7"
  }
}
