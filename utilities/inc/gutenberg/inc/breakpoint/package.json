{
  "scripts": {
    "watch": "wp-scripts start & npm run watch:scss",
    "build": "wp-scripts build & npm run build:scss",

    "watch:scss": "node ../../../../bin/build-css.mjs css --watch",
    "build:scss": "node ../../../../bin/build-css.mjs css",

    "i18n:scan": "npm run i18n:pot && npm run i18n:po",
    "i18n:pot": "wp i18n make-pot . languages/breakpoint.pot --domain=breakpoint --exclude=src,node_modules,**/*.min.* --package-name=Breakpoint",
    "i18n:po": "wp i18n update-po languages/breakpoint.pot languages",
    "i18n:create": "npm run i18n:mo & npm run i18n:json",
    "i18n:mo": "wp i18n make-mo languages",
    "i18n:json": "wp i18n make-json languages --no-purge"
  }
}
