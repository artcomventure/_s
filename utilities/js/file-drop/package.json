{
  "scripts": {
    "watch": "npm-run-all --parallel watch:*",
    "watch:scss": "node ../../bin/build-css.mjs . --watch",
    "watch:js": "node ../../bin/build-js.mjs . --watch",

    "build": "npm-run-all --parallel build:*",
    "build:scss": "node ../../bin/build-css.mjs .",
    "build:js": "node ../../bin/build-js.mjs .",

    "i18n:scan": "npm run i18n:pot && npm run i18n:po",
    "i18n:pot": "wp i18n make-pot ./ languages/file-drop.pot --domain=file-drop --exclude=src,node_modules,js/**/*.min.* --package-name='File Drop'",
    "i18n:po": "wp i18n update-po languages/file-drop.pot languages",
    "i18n:create": "npm run i18n:mo && npm run i18n:json",
    "i18n:mo": "wp i18n make-mo languages",
    "i18n:json": "wp i18n make-json languages --no-purge"
  }
}
