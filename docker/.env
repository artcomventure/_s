# set local env parameters in `.env.local`

PROJECT=PROJECT_NAME
COMPOSE_PROJECT_NAME=${PROJECT}
ABBR=PROJECT_ABBR

HOST=DEV_URL_WITHOUT_SCHEMA
DEV_URL=http://${HOST}
STAGE_URL=STAGE_URL_WITH_SCHEMA
LIVE_URL=LIVE_URL_WITH_SCHEMA

# tests (see THEME/utilities/tests/README.md)
TEST_PATHS="/" # space separated list of URLs to check
VISUAL_BLOCK="ccm.jivo.group"
PRIVACY_ALLOW="ccm.jivo.group"
A11Y_EXCLUDE=".ccm-root" # third-party consent banner
MAIL_FORMS=""

NGINX_VERSION=1.24.0-alpine
PHP_VERSION=8.3-fpm-alpine
MARIADB_VERSION=10.11.14

WORDPRESS_ROOT:../
WORDPRESS_DEBUG=1
