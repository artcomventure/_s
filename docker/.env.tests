# test options (see THEME/utilities/tests/README.md), override in `.env.local`

TEST_PATHS="sitemap /404-check" # space separated list of URLs to check; `sitemap` = all pages + one per post type
VISUAL_BLOCK="ccm.jivo.group"
PRIVACY_ALLOW="ccm.jivo.group"
A11Y_EXCLUDE=".ccm-root" # third-party consent banner
MAIL_FORMS=""
